{
  "schemaVersion": 1,
  "id": "argon",
  "version": "${version}",
  "name": "Argon",
  "description": "A modular, performance-focused Minecraft Java optimization suite.",
  "authors": ["Argon contributors"],
  "environment": "client",
  "entrypoints": {
